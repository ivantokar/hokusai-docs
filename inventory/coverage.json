  "nativeRestrictions": [
    {
      "capability": "HEIF / AVIF, JPEG XL, JPEG 2000, SVG and PDF input, other optional codecs",
      "note": "Depend on how libvips was built, not on Hokusai. `Hokusai.capabilities()` and `hokusai info` report them.",
      "family": "encoding-output"
    },
    {
      "capability": "Pango text rendering and font files",
      "note": "Needs a libvips with Pango; `TextStyle.fontFile` also needs fontconfig and a wrong file is only a libvips warning.",
      "family": "text-composition"
    },
    {
      "capability": "Magic Kernel resize kernels",
      "note": "libvips 8.17 or newer; reported instead of assumed.",
      "family": "geometry"
    },
    {
      "capability": "AVIF orientation as container rotation",
      "note": "Written by libvips 8.18, not by the 8.16 baseline; call autoOrient() first on older builds.",
      "family": "encoding-output"
    },
    {
      "capability": "HokusaiPDF",
      "note": "Needs Pango 1.44 or newer; the Hokusai product does not.",
      "family": "pdf"
    }
  ],
