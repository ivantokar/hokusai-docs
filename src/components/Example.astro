---
// A verified example: the code comes from examples/ (executed by Hokusai) and the images are
// its real output. Only the labels and alt text are translated, per page.
import { Code } from '@astrojs/starlight/components';
import snippets from '../generated/snippets.json';
import manifest from '../../public/generated/manifest.json';

interface Result { file: string; label?: string; alt: string }
interface Props { id: string; results?: Result[]; code?: boolean; wide?: boolean }

const { id, results = [], code = true, wide = false } = Astro.props;
const source = (snippets as Record<string, string>)[id];
const produced = ((manifest as any).examples as Record<string, any[]>)[id];
if (!source) throw new Error(`Example "${id}" has no snippet in examples/`);
if (!produced && results.length > 0) throw new Error(`Example "${id}" has no generated output; run npm run examples`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const info = (file: string) => (produced ?? []).find((r: any) => r.file === file);
const missing = results.filter((r) => !info(r.file));
if (missing.length) throw new Error(`Example "${id}" produced no ${missing.map((m) => m.file).join(', ')}`);
const kb = (bytes: number) => (bytes >= 1024 * 1024 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);
---

<div class="verified-example" data-example={id}>
  {code && <Code code={source} lang="swift" />}
  {
    results.length > 0 && (
      <ul class:list={['verified-results', { wide }]}>
        {results.map((result) => {
          const file = info(result.file);
          const shown = file.preview ?? file.file;
          return (
            <li>
              <img src={`${base}/generated/${id}/${shown}`} alt={result.alt} loading="lazy" width={file.width} height={file.height} />
              <figcaption>
                {result.label && <strong>{result.label}</strong>}
                <span>{file.format.toUpperCase()} · {file.width} × {file.height} · {kb(file.bytes)}</span>
              </figcaption>
            </li>
          );
        })}
      </ul>
    )
  }
</div>

<style>
  .verified-results {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    list-style: none;
    margin: 1rem 0 1.5rem;
    padding: 0;
  }
  .verified-results.wide { grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  li { margin: 0; }
  img {
    background: repeating-conic-gradient(var(--sl-color-gray-5) 0% 25%, var(--sl-color-gray-6) 0% 50%) 50% / 16px 16px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    height: auto;
    max-width: 100%;
    width: 100%;
  }
  figcaption { display: flex; flex-direction: column; font-size: var(--sl-text-xs); gap: 0.125rem; margin-top: 0.25rem; }
  figcaption span { color: var(--sl-color-gray-3); }
</style>
