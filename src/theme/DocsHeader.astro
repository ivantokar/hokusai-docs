---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import ThemeToggle from 'virtual:starlight/components/ThemeSelect';
import versions from '../versions.json';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';

const t = Astro.locals.t;
const { siteTitle, locale } = Astro.locals.starlightRoute;
const docsRoot = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsHome = locale ? `${docsRoot}/${locale}/` : `${docsRoot}/`;
const libraryLogo = `${docsRoot}/hokusai-icon.png`;
---

<header class="site-theme-header">
  <div class="site-theme-brand">
    <a href={docsHome}>
      <img class="site-theme-library-logo" src={libraryLogo} alt="" />
      <span class="site-theme-library-name">{siteTitle}</span>
    </a>
    <span title={t('hokusai.documentation')}>{versions.hokusai}</span>
  </div>
  <div class="site-theme-header-actions">
    <a class="site-theme-main-site" href="https://ivantokar.com">{t('hokusai.mainSite')}</a>
    {config.pagefind && <Search />}
    <LanguageSelect />
    <ThemeToggle />
  </div>
</header>
