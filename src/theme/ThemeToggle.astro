<site-theme-toggle class="site-theme-toggle">
  <button type="button" aria-label="Switch to light mode" title="Switch to light mode">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" />
    </svg>
  </button>
</site-theme-toggle>

<script>
  class SiteThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const updateLabel = () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        const label = `Switch to ${nextTheme} mode`;
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
      };

      updateLabel();
      button?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        localStorage.setItem('theme', theme);
        updateLabel();
      });
    }
  }

  customElements.define('site-theme-toggle', SiteThemeToggle);
</script>
